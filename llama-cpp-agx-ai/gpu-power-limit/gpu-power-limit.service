[Unit]
Description=Set the NVIDIA GPU power and clock limits and create the NVIDIA device nodes
Documentation=file:///usr/local/sbin/gpu-power-limit.sh
After=systemd-modules-load.service nvidia-persistenced.service
Wants=nvidia-persistenced.service
# Run before Proxmox autostarts the guests, as the agx-ai LXC container needs /dev/nvidia-uvm-tools.
Before=pve-guests.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gpu-power-limit.sh
# The script waits up to 300 s for the GPU. Proxmox waits for this before starting the guests.
TimeoutStartSec=360

[Install]
WantedBy=multi-user.target
