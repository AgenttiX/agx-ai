+@triton.jit
+def _e4m3_bits_to_fp16(x):
+    """Convert FP8 e4m3fn values, loaded as uint8, to FP16 (exact).
+
+    The sign, exponent and mantissa bits shifted into their FP16 positions give
+    the value times 2**-8 (exponent bias 15 instead of 7), subnormals included,
+    so a multiplication by 256 restores it. Cheap enough for the one-warp tiles
+    of the prefill configuration (a version with int32 ops and selects was ~25
+    times slower there).
+    """
+    x = x.to(tl.int16)
+    bits = ((x & 0x80) << 8) | ((x & 0x7F) << 7)
+    return bits.to(tl.float16, bitcast=True) * 256.0
+
