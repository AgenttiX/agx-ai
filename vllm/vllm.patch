+def empty_pinned(shape: Sequence[int], dtype: torch.dtype) -> torch.Tensor:
+    """Allocate a pinned CPU tensor of exactly its size.
+
+    pin_memory=True uses PyTorch's caching host allocator, which rounds every
+    block up to the next power of two, e.g. a 48 GiB table to 64 GiB of locked
+    RAM. On CUDA, tensors of 1 MiB or more are instead backed by their own
+    anonymous memory mapping, registered with cudaHostRegister and unregistered
+    before the mapping is released with the tensor.
+    """
+    from vllm.platforms import current_platform
+
+    nbytes = math.prod(shape) * dtype.itemsize
+    if not current_platform.is_cuda() or nbytes < 1 << 20:
+        return torch.empty(tuple(shape), dtype=dtype, device="cpu", pin_memory=True)
+    buf = mmap.mmap(-1, nbytes)
+    host = torch.frombuffer(buf, dtype=torch.uint8)
+    cudart = torch.cuda.cudart()
+    ptr = host.data_ptr()
+    if cudart.cudaHostRegister(ptr, nbytes, 0) != cudart.cudaError.success:
+        return torch.empty(tuple(shape), dtype=dtype, device="cpu", pin_memory=True)
+    weakref.finalize(buf, cudart.cudaHostUnregister, ptr)
+    return host.view(dtype).view(tuple(shape))
+
+
+def pin_memory_exact(tensor: torch.Tensor) -> torch.Tensor:
+    """Copy a tensor to pinned CPU memory of exactly its size (see empty_pinned)."""
+    out = empty_pinned(tensor.shape, tensor.dtype)
+    out.copy_(tensor)
+    return out
+
+
