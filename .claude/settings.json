{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**.env)",
      "Read(/litellm/db/**)",
      "Read(/open-webui/data/**)",
      "Read(/ssh/id_*[!b])",
      "Read(/ssh/id_*[!u]b)",
      "Read(/ssh/id_*[!p]ub)",
      "Read(/ssh/id_*[!.]pub)"
    ]
  },
  "enabledPlugins": {
    "claude-security@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  }
}
