{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git pull *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(llama-cpp.env)",
      "Read(/litellm/db/**)",
      "Read(/open-webui/data/**)",
      "Read(/ssh/id_*[!b])",
      "Read(/ssh/id_*[!u]b)",
      "Read(/ssh/id_*[!p]ub)",
      "Read(/ssh/id_*[!.]pub)"
    ]
  },
  "enabledPlugins": {
    "claude-security@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  }
}
