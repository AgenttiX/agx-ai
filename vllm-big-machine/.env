# The vLLM configuration started by "docker compose up -d" (see README.md). Uncomment one block.
# Model ids: Qwen/Qwen3.8-27B or google/gemma-4-26b-a4b-qat on port 9932, the embedding model on port 9934.

# 1) 2 GPUs: Qwen3.8-27B
# COMPOSE_PROFILES=llm
# LLM_CONFIG=config-qwen3.8-27b-tp2.yaml
# LLM_GPUS=0,1

# 2) 2 GPUs: Gemma 4 26B-A4B QAT
# COMPOSE_PROFILES=llm
# LLM_CONFIG=config-gemma-4-26b-a4b-qat-tp2.yaml
# LLM_GPUS=0,1

# 3) 2 GPUs: Qwen3.8-27B + Qwen3-Embedding-0.6B, both with tensor parallelism (the default, see README.md)
COMPOSE_PROFILES=llm,embedding
LLM_CONFIG=config-qwen3.8-27b-tp2-embedding.yaml
LLM_GPUS=0,1
EMBEDDING_CONFIG=config-embedding-tp2-qwen.yaml
EMBEDDING_GPUS=0,1

# 4) 2 GPUs: Gemma 4 26B-A4B QAT + Qwen3-Embedding-4B (FP8), both with tensor parallelism
# COMPOSE_PROFILES=llm,embedding
# LLM_CONFIG=config-gemma-4-26b-a4b-qat-tp2-embedding.yaml
# LLM_GPUS=0,1
# EMBEDDING_CONFIG=config-embedding-tp2-gemma.yaml
# EMBEDDING_GPUS=0,1

# 5) 1 GPU: Qwen3.8-27B (GPU 1, which has no desktop session on it). 5 + 7: add embedding to the profiles.
# COMPOSE_PROFILES=llm
# LLM_CONFIG=config-qwen3.8-27b-1gpu.yaml
# LLM_GPUS=1

# 6) 1 GPU: Gemma 4 26B-A4B QAT (GPU 1). 6 + 7: add embedding to the profiles.
# COMPOSE_PROFILES=llm
# LLM_CONFIG=config-gemma-4-26b-a4b-qat-1gpu.yaml
# LLM_GPUS=1

# 7) 1 GPU: Qwen3-Embedding-4B (GPU 0)
# COMPOSE_PROFILES=embedding
# EMBEDDING_CONFIG=config-embedding-1gpu.yaml
# EMBEDDING_GPUS=0

# 8) CPU: Qwen3-Embedding-0.6B. 1 + 8, 2 + 8: llm,embedding-cpu
# COMPOSE_PROFILES=embedding-cpu
