+# agx-ai: PyTorch versions of the kernels above for the vision encoder on the CPU
+# (INKLING2_VISION_DEVICE=cpu, see `vision.cpu_vision_enabled`), in fp32 with the
+# same bf16 rounding points. Triton kernels run only on the GPU.
+
+
+def _bf16_round(x: torch.Tensor) -> torch.Tensor:
+    return x.to(torch.bfloat16).to(torch.float32)
+
+
+def _cpu_layer_norm(x: torch.Tensor, norm: torch.nn.LayerNorm) -> torch.Tensor:
+    return torch.nn.functional.layer_norm(
+        x, x.shape[-1:], norm.weight.float(), norm.bias.float(), norm.eps
+    )
+
+
+def _cpu_gather_patches(
+    pixels: torch.Tensor,
+    offsets: torch.Tensor,
+    patch_size: int,
+    mean: tuple[float, float, float],
+    clip_std: tuple[float, float, float],
+    std: tuple[float, float, float],
+) -> torch.Tensor:
+    side = pixels.shape[1]
+    features = torch.arange(patch_size * patch_size * 3)
+    within = (features // (patch_size * 3)) * (side * 3) + features % (patch_size * 3)
+    index = offsets.to(torch.int64)[:, None] + within[None, :]
+    values = pixels.reshape(-1).to(torch.float32)[index]
+    channel = features % 3
+    mean_t = torch.tensor(mean, dtype=torch.float32)[channel]
+    clip_std_t = torch.tensor(clip_std, dtype=torch.float32)[channel]
+    std_t = torch.tensor(std, dtype=torch.float32)[channel]
+    values = _bf16_round((values / 255.0 - mean_t) / clip_std_t)
+    return 2.0 * (values * std_t + mean_t) - 1.0
+
+
+def _cpu_source_coords(
+    index: torch.Tensor, target: torch.Tensor, source: int
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    coord = (source * (index + 0.5)) / target - 0.5
+    coord = coord.clamp(0.0, source - 1.0)
+    src0 = coord.floor().to(torch.int64)
+    src1 = (src0 + 1).clamp(max=source - 1)
+    w1 = coord - src0.to(torch.float32)
+    return src0, src1, 1.0 - w1, w1
+
+
+def _cpu_embed_tokens(
+    patch_embeds: torch.Tensor,
+    patch_rows: torch.Tensor,
+    position_grid: torch.Tensor,
+    meta: torch.Tensor,
+    class_embedding: torch.Tensor,
+    cls_position_embedding: torch.Tensor,
+    ln_pre: torch.nn.LayerNorm,
+    ln_1: torch.nn.LayerNorm,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    meta = meta.to(torch.int64)
+    grid_h, grid_w, dim = position_grid.shape
+    grid = position_grid.reshape(-1, dim).to(torch.float32)
+    is_cls = meta[:, 0] < 0
+    y, x = meta[:, 0].clamp(min=0).float(), meta[:, 1].clamp(min=0).float()
+    height, width = meta[:, 2].float(), meta[:, 3].float()
+    y0, y1, wy0, wy1 = _cpu_source_coords(y, height, grid_h)
+    x0, x1, wx0, wx1 = _cpu_source_coords(x, width, grid_w)
+    top = grid[y0 * grid_w + x0] * wx0[:, None] + grid[y0 * grid_w + x1] * wx1[:, None]
+    bottom = (
+        grid[y1 * grid_w + x0] * wx0[:, None] + grid[y1 * grid_w + x1] * wx1[:, None]
+    )
+    position = _bf16_round(top * wy0[:, None] + bottom * wy1[:, None])
+    rows = patch_rows.to(torch.int64).clamp(min=0)
+    hidden = patch_embeds.to(torch.float32)[rows] + position
+    cls = class_embedding.float() + cls_position_embedding.float()
+    hidden = torch.where(is_cls[:, None], cls[None, :], hidden)
+    hidden = _bf16_round(_cpu_layer_norm(_bf16_round(hidden), ln_pre))
+    return hidden, _cpu_layer_norm(hidden, ln_1)
+
+
+def _cpu_apply_rotary_qk_(qkv: torch.Tensor, meta: torch.Tensor, num_heads: int) -> None:
+    num_tokens, width = qkv.shape
+    dim = width // 3
+    head_dim = dim // num_heads
+    quarter = head_dim // 4
+    inv_freq = _rope_inv_freq(head_dim, qkv.device)
+    # The first half of the pairs rotate by x + 1, the rest by y + 1 (CLS: 0).
+    pos_x = (meta[:, 1].to(torch.float32) + 1.0)[:, None]
+    pos_y = (meta[:, 0].to(torch.float32) + 1.0)[:, None]
+    angle = torch.cat([pos_x * inv_freq, pos_y * inv_freq], dim=1)[:, None, :]
+    cos, sin = angle.cos(), angle.sin()
+    assert angle.shape[-1] == 2 * quarter
+    for start in (0, dim):
+        part = qkv[:, start : start + dim].view(num_tokens, num_heads, head_dim // 2, 2)
+        even, odd = part[..., 0].float(), part[..., 1].float()
+        new_even = even * cos - odd * sin
+        new_odd = odd * cos + even * sin
+        part[..., 0] = new_even.to(qkv.dtype)
+        part[..., 1] = new_odd.to(qkv.dtype)
+
+
+def _cpu_scaled_residual_norm_(
+    hidden: torch.Tensor,
+    update: torch.Tensor,
+    gamma: torch.Tensor,
+    norm: torch.nn.LayerNorm | None,
+) -> torch.Tensor | None:
+    new = _bf16_round(hidden.float() + _bf16_round(update.float() * gamma.float()))
+    hidden.copy_(new)
+    return None if norm is None else _cpu_layer_norm(new, norm)
