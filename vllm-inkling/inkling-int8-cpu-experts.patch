+def agx_option(name: str, default=None):
+    """agx-ai: an option of these patches from `additional_config` of the vLLM
+    configuration (`--additional-config '{"inkling2_int8_weights": true}'`,
+    part of the compile cache key), else from the environment variable of
+    the same name in upper case."""
+    import json
+    import os
+
+    from vllm.config import get_current_vllm_config_or_none
+
+    config = get_current_vllm_config_or_none()
+    extra = config.additional_config if config is not None else None
+    if isinstance(extra, dict) and name in extra:
+        return extra[name]
+    value = os.environ.get(name.upper())
+    return default if value is None else json.loads(value)
diff -ruN a/models/inkling2/nvidia/ops/w8_linear.py b/models/inkling2/nvidia/ops/w8_linear.py
--- a/models/inkling2/nvidia/ops/w8_linear.py	1970-01-01 02:00:00.000000000 +0200
+++ b/models/inkling2/nvidia/ops/w8_linear.py	2026-11-22 15:25:46.850291244 +0200
@@ -0,0 +1,366 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""agx-ai: int8 weight-only linears for the BF16 projections of Inkling 2
+(the attention's `qkvr` and `wo_ud`, the LM head) and an int8 token
+embedding, with the option `inkling2_int8_weights` (`agx_option`).
+
+Decoding reads every BF16 weight once per step, and on GPUs without much
+memory bandwidth (the RTX 3090: 936 GB/s) these weights take about half of
+a step. Each output row gets one symmetric fp32 scale (`amax / 127`); the
+activations stay BF16 and the products accumulate in fp32. Batches of at most
+`MAX_M` rows run a split-K Triton kernel derived from `ll_gemm_sm120`
+(weights converted to BF16 in registers); larger batches dequantize the
+weights in row chunks and use cuBLAS."""
+
+import functools
+
+import torch
+from torch import nn
+
+from vllm.triton_utils import tl, triton
+from vllm.utils.torch_utils import current_stream
+
+from . import agx_option
+from .ll_gemm_sm120 import _MAX_TILES, _MP, MAX_M
+
+# Rows of a weight dequantized at a time for batches over MAX_M rows (bounds
+# the temporary memory of the LM head: 16384 x 2304 BF16 = 72 MiB).
+_DEQUANT_ROWS = 16384
+
+
+def int8_weights_enabled() -> bool:
+    """Whether to store the BF16 projections and embedding in int8
+    (`inkling2_int8_weights`, see `agx_option`)."""
+    return bool(agx_option("inkling2_int8_weights", False))
+
+
+@triton.jit
+def _w8_gemm_kernel(
+    X,
+    W,
+    WS,
+    Y,
+    P,
+    C,
+    M,
+    N,
+    K,
+    SXM,
+    SWN,
+    SYM,
+    BN: tl.constexpr,
+    BK: tl.constexpr,
+    K_PER_SPLIT: tl.constexpr,
+    SPLIT: tl.constexpr,
+    MP: tl.constexpr,
+):
+    """`_ll_gemm_kernel` with int8 weights: program `(n, s)` computes column
+    tile `n` over K range `s`. The last program of a tile to finish (counted
+    in `C`, reset to 0 after) sums the fp32 partials in split order, so
+    results are deterministic, and applies the row scales."""
+    pid_n = tl.program_id(0)
+    s = tl.program_id(1)
+    rows = tl.arange(0, MP)
+    cols = pid_n * BN + tl.arange(0, BN)
+    ks = s * K_PER_SPLIT + tl.arange(0, BK)
+    x_ptrs = X + (rows[:, None] * SXM + ks[None, :])
+    w_ptrs = W + (cols[None, :] * SWN + ks[:, None])
+    acc = tl.zeros((MP, BN), tl.float32)
+    for _ in range(0, tl.minimum(K - s * K_PER_SPLIT, K_PER_SPLIT), BK):
+        w = tl.load(w_ptrs, (cols[None, :] < N) & (ks[:, None] < K), other=0)
+        x = tl.load(x_ptrs, (rows[:, None] < M) & (ks[None, :] < K), other=0)
+        acc += tl.dot(x, w.to(tl.bfloat16))
+        x_ptrs += BK
+        w_ptrs += BK
+        ks += BK
+    is_last = True
+    if SPLIT > 1:
+        offs = rows[:, None] * N + cols[None, :]
+        mask = (rows[:, None] < M) & (cols < N)[None, :]
+        tl.store(P + (s * MP * N + offs), acc, mask)
+        tl.debug_barrier()
+        is_last = tl.atomic_add(C + pid_n, 1, sem="acq_rel", scope="gpu") == SPLIT - 1
+        if is_last:
+            acc = tl.zeros((MP, BN), tl.float32)
+            for i in tl.static_range(SPLIT):
+                acc += tl.load(P + (i * MP * N + offs), mask, cache_modifier=".cg")
+            tl.atomic_xchg(C + pid_n, 0, sem="relaxed", scope="gpu")
+    if is_last:
+        acc *= tl.load(WS + cols, cols < N, other=0)[None, :]
+        tl.store(
+            Y + (rows[:, None] * SYM + cols[None, :]),
+            acc.to(Y.dtype.element_ty),
+            (rows[:, None] < M) & (cols[None, :] < N),
+        )
+
+
+@triton.jit
+def _w8_qkv_kernel(
+    XQ,
+    XK,
+    XV,
+    W,
+    WS,
+    Y,
+    M,
+    N,
+    K,
+    S1,
+    S2,
+    SXQ,
+    SXK,
+    SXV,
+    SWN,
+    SYM,
+    BN: tl.constexpr,
+    BK: tl.constexpr,
+    MP: tl.constexpr,
+):
+    """Three int8 linears in one launch (`ll_gemm_sm120.qkv_bmm`): columns
+    `[0, S1)` of `Y` are from `XQ`, `[S1, S2)` from `XK` and `[S2, N)` from
+    `XV`. Each segment has its own column tiles, so that no tile spans two
+    inputs."""
+    pid = tl.program_id(0)
+    tiles_q = tl.cdiv(S1, BN)
+    tiles_k = tl.cdiv(S2 - S1, BN)
+    x, sx, start, end = XQ, SXQ, pid * 0, S1
+    if pid >= tiles_q + tiles_k:
+        x, sx, start, end = XV, SXV, S2 + (pid - tiles_q - tiles_k) * BN, N
+    elif pid >= tiles_q:
+        x, sx, start, end = XK, SXK, S1 + (pid - tiles_q) * BN, S2
+    else:
+        start = pid * BN
+    rows = tl.arange(0, MP)
+    cols = start + tl.arange(0, BN)
+    ks = tl.arange(0, BK)
+    x_ptrs = x + (rows[:, None] * sx + ks[None, :])
+    w_ptrs = W + (cols[None, :] * SWN + ks[:, None])
+    acc = tl.zeros((MP, BN), tl.float32)
+    for _ in range(0, K, BK):
+        w = tl.load(w_ptrs, (cols[None, :] < end) & (ks[:, None] < K), other=0)
+        xv = tl.load(x_ptrs, (rows[:, None] < M) & (ks[None, :] < K), other=0)
+        acc += tl.dot(xv, w.to(tl.bfloat16))
+        x_ptrs += BK
+        w_ptrs += BK
+        ks += BK
+    acc *= tl.load(WS + cols, cols < end, other=0)[None, :]
+    tl.store(
+        Y + (rows[:, None] * SYM + cols[None, :]),
+        acc.to(Y.dtype.element_ty),
+        (rows[:, None] < M) & (cols[None, :] < end),
+    )
+
+
+@triton.jit
+def _w8_dequant_kernel(W, WS, Y, K, SWN, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    offs = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < K
+    w = tl.load(W + row * SWN + offs, mask, other=0).to(tl.float32)
+    tl.store(Y + row * K + offs, (w * tl.load(WS + row)).to(tl.bfloat16), mask)
+
+
+@functools.cache
+def _counter(stream: int) -> torch.Tensor:
+    """Split-K tile counters for one stream; each launch leaves them zeroed."""
+    return torch.zeros(_MAX_TILES, dtype=torch.int32, device="cuda")
+
+
+@functools.cache
+def _config(n: int, k: int) -> tuple[int, int, int, int, int]:
+    """`(BN, BK, split, num_warps, num_stages)` from a sweep on the RTX 3090
+    with one row (a decoding step): 32-column tiles over all of K for the
+    wide projections (qkvr: 26 us, 765 GB/s; the LM head: 528 us, 877 GB/s),
+    split-K for the narrow ones (k, v: 5 us)."""
+    if n < 2048:
+        return 32, 256, 6, 4, 3
+    return 32, 128, 1, 4, 3
+
+
+def quantize_rows(weight: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Symmetric int8 with one fp32 scale per row, in chunks of rows to bound
+    the temporary memory."""
+    q = torch.empty(weight.shape, dtype=torch.int8, device=weight.device)
+    scale = torch.empty(weight.shape[0], dtype=torch.float32, device=weight.device)
+    for start in range(0, weight.shape[0], 8192):
+        rows = slice(start, start + 8192)
+        w = weight[rows].float()
+        s = w.abs().amax(dim=1).clamp(min=1e-12) / 127
+        q[rows] = torch.round(w / s[:, None]).clamp(-127, 127).to(torch.int8)
+        scale[rows] = s
+    return q, scale
+
+
+def dequantize_rows(q: torch.Tensor, scale: torch.Tensor) -> torch.Tensor:
+    """BF16 `q * scale[:, None]` of int8 rows `[N, K]`."""
+    n, k = q.shape
+    out = torch.empty((n, k), dtype=torch.bfloat16, device=q.device)
+    if n:
+        block = 1024
+        _w8_dequant_kernel[(n, triton.cdiv(k, block))](
+            q, scale, out, k, q.stride(0), BLOCK=block
+        )
+    return out
+
+
+def w8_linear(
+    x: torch.Tensor,
+    q: torch.Tensor,
+    scale: torch.Tensor,
+    out_dtype: torch.dtype | None = None,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """`x @ (q * scale[:, None]).T` for BF16 `x` `[..., K]` and int8 `q`
+    `[N, K]` (possibly a slice of rows), into `out` `[M, N]` if given."""
+    n, k = q.shape
+    assert q.stride(1) == 1 and x.shape[-1] == k
+    lead = x.shape[:-1]
+    x2 = x.reshape(-1, k)
+    m = x2.shape[0]
+    if out is None:
+        out = x2.new_empty((m, n), dtype=out_dtype or x.dtype)
+    if m == 0:
+        return out.view(*lead, n)
+    if m > MAX_M:
+        for start in range(0, n, _DEQUANT_ROWS):
+            rows = slice(start, start + _DEQUANT_ROWS)
+            w = dequantize_rows(q[rows], scale[rows])
+            if out.dtype == torch.bfloat16:
+                torch.mm(x2, w.t(), out=out[:, rows])
+            else:
+                out[:, rows] = torch.mm(x2, w.t(), out_dtype=out.dtype)
+        return out.view(*lead, n)
+    if x2.stride(1) != 1:
+        x2 = x2.contiguous()
+    bn, bk, split, num_warps, num_stages = _config(n, k)
+    k_tiles = triton.cdiv(k, bk)
+    split = min(split, k_tiles)
+    tiles_per_split = triton.cdiv(k_tiles, split)
+    split = triton.cdiv(k_tiles, tiles_per_split)
+    n_tiles = triton.cdiv(n, bn)
+    partials = counter = None
+    if split > 1:
+        assert n_tiles <= _MAX_TILES
+        partials = torch.empty((split, _MP, n), dtype=torch.float32, device=x.device)
+        counter = _counter(current_stream().cuda_stream)
+    _w8_gemm_kernel[(n_tiles, split)](
+        x2,
+        q,
+        scale,
+        out,
+        partials,
+        counter,
+        m,
+        n,
+        k,
+        x2.stride(0),
+        q.stride(0),
+        out.stride(0),
+        BN=bn,
+        BK=bk,
+        K_PER_SPLIT=tiles_per_split * bk,
+        SPLIT=split,
+        MP=_MP,
+        num_warps=num_warps,
+        num_stages=num_stages,
+    )
+    return out.view(*lead, n)
+
+
+def quantize_module(module: nn.Module) -> None:
+    """Replace `module.weight` (BF16 `[N, K]`) by int8 rows `w8_q` and scales
+    `w8_scale`; `weight` keeps its dtype with no elements."""
+    weight = module.weight
+    q, scale = quantize_rows(weight.data)
+    module.register_buffer("w8_q", q, persistent=False)
+    module.register_buffer("w8_scale", scale, persistent=False)
+    weight.data = weight.data.new_empty((0,))
+
+
+def is_quantized(module: nn.Module) -> bool:
+    return getattr(module, "w8_q", None) is not None
+
+
+def weight_rows(module: nn.Module, rows: slice | None = None) -> torch.Tensor:
+    """BF16 rows of a weight, dequantized if `module` is quantized."""
+    if not is_quantized(module):
+        weight = module.weight
+        return weight if rows is None else weight[rows]
+    rows = rows or slice(None)
+    return dequantize_rows(module.w8_q[rows], module.w8_scale[rows])
+
+
+def embedding(module: nn.Module, ids: torch.Tensor) -> torch.Tensor:
+    """BF16 rows `ids` of a quantized embedding table."""
+    return (module.w8_q[ids].float() * module.w8_scale[ids, None]).to(torch.bfloat16)
+
+
+def embed(module: nn.Module, ids: torch.Tensor) -> torch.Tensor:
+    """The embedding rows `ids` of `module` (a `VocabParallelEmbedding`)."""
+    return embedding(module, ids) if is_quantized(module) else module(ids)
+
+
+# (BN, BK, num_warps, num_stages) of `w8_qkv`: 26 us for the q, k and v
+# projections of a loop layer on the RTX 3090 (three launches: 30 us).
+QKV_CONFIG = (32, 128, 4, 3)
+
+
+def w8_qkv(
+    x_q: torch.Tensor,
+    x_k: torch.Tensor,
+    x_v: torch.Tensor,
+    q: torch.Tensor,
+    scale: torch.Tensor,
+    k_start: int,
+    v_start: int,
+) -> torch.Tensor:
+    """One launch of three int8 linears on consecutive row ranges of `q`
+    `[N, K]` (`ll_gemm_sm120.qkv_bmm`): output columns `[0, k_start)` from
+    `x_q`, `[k_start, v_start)` from `x_k` and the rest from `x_v`, each
+    `[M, K]` with M <= MAX_M."""
+    m, k = x_q.shape
+    n = q.shape[0]
+    bn, bk, num_warps, num_stages = QKV_CONFIG
+    assert 0 < m <= MAX_M and q.stride(1) == 1
+    assert all(x.shape == (m, k) and x.stride(1) == 1 for x in (x_q, x_k, x_v))
+    assert 0 < k_start < v_start < n
+    out = torch.empty((m, n), dtype=x_q.dtype, device=x_q.device)
+    tiles = (
+        triton.cdiv(k_start, bn)
+        + triton.cdiv(v_start - k_start, bn)
+        + triton.cdiv(n - v_start, bn)
+    )
+    _w8_qkv_kernel[(tiles,)](
+        x_q,
+        x_k,
+        x_v,
+        q,
+        scale,
+        out,
+        m,
+        n,
+        k,
+        k_start,
+        v_start,
+        x_q.stride(0),
+        x_k.stride(0),
+        x_v.stride(0),
+        q.stride(0),
+        out.stride(0),
+        BN=bn,
+        BK=bk,
+        MP=_MP,
+        num_warps=num_warps,
+        num_stages=num_stages,
+    )
+    return out
+
+
+def use_w8_qkv(x_q: torch.Tensor, x_k: torch.Tensor, x_v: torch.Tensor) -> bool:
+    """Whether `w8_qkv` serves BF16 `x_q`, `x_k`, `x_v` `[M, K]`."""
+    return (
+        x_q.ndim == 2
+        and 0 < x_q.shape[0] <= MAX_M
+        and x_q.shape == x_k.shape == x_v.shape
+        and x_q.stride(1) == x_k.stride(1) == x_v.stride(1) == 1
+    )
