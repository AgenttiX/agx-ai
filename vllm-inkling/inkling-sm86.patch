diff -ruN a/models/inkling2/nvidia/ops/__init__.py b/models/inkling2/nvidia/ops/__init__.py
--- a/models/inkling2/nvidia/ops/__init__.py	2026-11-22 03:21:55.562065771 +0200
+++ b/models/inkling2/nvidia/ops/__init__.py	2026-11-22 03:22:11.340912948 +0200
@@ -11,3 +11,55 @@
     from vllm.platforms import current_platform
 
     return current_platform.is_device_capability_family(100)
+
+
+@functools.cache
+def use_portable_fallbacks() -> bool:
+    """Whether to take the SM12x fallbacks that do not need Hopper features
+    (no TMA, wgmma or Inkling2 CUDA kernels, ~100 KB of shared memory per
+    block): SM12x and pre-Hopper GPUs such as sm_86. The routed experts
+    stay on the Hopper (Humming) path below SM90, as the SM12x experts use
+    native FP4 MMA."""
+    from vllm.platforms import current_platform
+
+    return current_platform.is_device_capability_family(
+        120
+    ) or not current_platform.has_device_capability(90)
+
+
+def _disable_pdl_before_sm90() -> None:
+    """Programmatic dependent launch (`launch_pdl`, `gdc_wait`,
+    `gdc_launch_dependents`) needs SM90: the `griddepcontrol` PTX does not
+    exist for sm_8x. Below SM90, the Triton GDC calls compile to nothing and
+    launches drop the PDL attribute, so that kernels are ordered by the
+    stream as usual. Only applied in processes that import Inkling2 on such
+    a GPU, where these calls could not compile anyway."""
+    from vllm.platforms import current_platform
+
+    if not current_platform.is_cuda() or current_platform.has_device_capability(90):
+        return
+    from triton.backends.nvidia import compiler
+    from triton.language import core
+    from triton.language.extra import cuda as tl_cuda
+
+    if getattr(tl_cuda, "_inkling2_no_pdl", False):
+        return
+
+    @core.extern
+    def _no_gdc(_semantic=None):
+        return None
+
+    tl_cuda.gdc_wait = _no_gdc
+    tl_cuda.gdc_launch_dependents = _no_gdc
+    parse_options = compiler.CUDABackend.parse_options
+
+    def _parse_options_without_pdl(self, opts):
+        opts = dict(opts)
+        opts["launch_pdl"] = False
+        return parse_options(self, opts)
+
+    compiler.CUDABackend.parse_options = _parse_options_without_pdl
+    tl_cuda._inkling2_no_pdl = True
+
+
+_disable_pdl_before_sm90()
