+// dec_pv_i4: warp `warp` owns the 64-d groups D / 64 / 4 * warp ..; m-tile
+// 4 a + hm of group a has rows g <-> d = 64 ga + 8 g + 2 hm and g + 8 <-> + 1.
+template <int D, int NT, class R>
+__device__ __forceinline__ void dec_pv_i4(float (&o)[dec_mtiles(D)][NT][4],
+                                          uint32_t p_smem, const uint8_t* stage,
+                                          int warp, int lane) {
+  constexpr int kGroups = D / 64 / kWarps;  // 64-d groups per warp
+  static_assert(kGroups >= 1 && 4 * kGroups == dec_mtiles(D),
+                "four m-tiles per 64-d group");
+  const int g = lane >> 2, q = lane & 3;
+  const int mi = lane >> 3, l8 = lane & 7;
+  #pragma unroll
+  for (int j = 0; j < kLoadTileTokens / kMmaK; ++j) {
+    uint32_t bp[NT][2];
+  #pragma unroll
+    for (int np = 0; np < NT; np += 2) {
+      const int nm = np + (mi >> 1) < NT ? np + (mi >> 1) : NT - 1;
+      uint32_t r[4];
+      ldmatrix_x4(r,
+                  p_smem + (8 * nm + l8) * kDecPPitch + 32 * j + 16 * (mi & 1));
+      bp[np][0] = r[0];
+      bp[np][1] = r[1];
+      if (np + 1 < NT) {
+        bp[np + 1][0] = r[2];
+        bp[np + 1][1] = r[3];
+      }
+    }
+    // Zero points of the tokens 2q, 2q+1 (register 0) and 2q+8, 2q+9 (1).
+    uint32_t zp[4];
+  #pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      zp[i] = i4_zp(*reinterpret_cast<const float*>(
+          stage + R::vs(kMmaK * j + 2 * q + v_token_offset(i))));
+    }
+    const uint32_t bias0 = i4_bias2(zp[0], zp[1]);
+    const uint32_t bias1 = i4_bias2(zp[2], zp[3]);
+  #pragma unroll
+    for (int a = 0; a < kGroups; ++a) {
+      uint32_t w[4];
+  #pragma unroll
+      for (int i = 0; i < 4; ++i) {
+        const int tok = kMmaK * j + 2 * q + v_token_offset(i);
+        w[i] = *reinterpret_cast<const uint32_t*>(
+            stage + R::v(tok, 32 * (kGroups * warp + a) + 4 * g));
+      }
+      uint32_t b0[8], b1[8];  // d = 64 ga + 8 g + n_sub
+      i4_v_pair(w[0], w[1], bias0, b0);
+      i4_v_pair(w[2], w[3], bias1, b1);
+  #pragma unroll
+      for (int hm = 0; hm < 4; ++hm) {
+        const uint32_t am[4] = {b0[2 * hm], b0[2 * hm + 1], b1[2 * hm],
+                                b1[2 * hm + 1]};
+  #pragma unroll
+        for (int n = 0; n < NT; ++n) {
+          mma_m16n8k16_f16f32(o[4 * a + hm][n], am, bp[n]);
+        }
+      }
+    }
+  }
+}
