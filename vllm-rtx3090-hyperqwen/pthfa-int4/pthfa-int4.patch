+// SPDX-License-Identifier: Apache-2.0
+//
+// int4.cuh: register conversion of vLLM's int4_per_token_head KV cache
+// (two unsigned 4-bit values per byte, d even in the low nibble; one fp32
+// scale per (token, head) whose 4 low mantissa bits hold the zero point zp)
+// into the fp16 MMA fragments of the pth kernels. Dequantised value:
+// (u - zp) * scale. (u - zp) is computed exactly in fp16 by the magic-number
+// trick: fp16 bits 0x6400 | u = 1024 + u, minus 1024 + zp.
+
+#pragma once
+
+#include <cstdint>
+
+#include "ptx.cuh"
+
+namespace pth_attn {
+
+constexpr uint32_t kI4NibbleMask = 0x000F000Fu;
+constexpr uint32_t kI4Magic = 0x64006400u;  // fp16 1024 in both halves
+constexpr uint32_t kI4ZpMask = 0xFu;
+// V token pairing: (t.b0, t.b1, t1.b0, t1.b1) and (t.b2, t.b3, t1.b2, t1.b3).
+constexpr uint32_t kI4VSelLo = 0x5410u;
+constexpr uint32_t kI4VSelHi = 0x7632u;
+static_assert(prmt_selector_is_copy_only(kI4VSelLo) &&
+                  prmt_selector_is_copy_only(kI4VSelHi),
+              "selectors must copy bytes");
+
+// The zero point of a raw scale word and the scale with it cleared.
+PTH_HD uint32_t i4_zp(float raw) { return f32_as_u32(raw) & kI4ZpMask; }
+PTH_HD float i4_scale(float raw) {
+  return u32_as_f32(f32_as_u32(raw) & ~kI4ZpMask);
+}
+// Subtrahend half2 (1024 + zp_lo, 1024 + zp_hi).
+PTH_HD uint32_t i4_bias2(uint32_t zp_lo, uint32_t zp_hi) {
+  return kI4Magic | zp_lo | (zp_hi << 16);
+}
+
+// 8 nibbles (n_i at bits 4i) -> 4 half2: out[i] = (n_i - zp_lo, n_{i+4} -
+// zp_hi) with bias = i4_bias2(zp_lo, zp_hi). Exact.
+PTH_HD void cvt8_u4_f16x2(uint32_t w, uint32_t bias, uint32_t (&out)[4]) {
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    out[i] = sub_f16x2(((w >> (4 * i)) & kI4NibbleMask) | kI4Magic, bias);
+  }
+}
+
+// V: words of tokens t and t + 1 (8 d each, d0 + 0..7) -> out[i] = half2
+// (V[t][d0 + i] - zp_t, V[t+1][d0 + i] - zp_t1) for i = 0..7, a B (or A)
+// register holding a token pair at one d.
+PTH_HD void i4_v_pair(uint32_t w_t, uint32_t w_t1, uint32_t bias,
+                      uint32_t (&out)[8]) {
+  const uint32_t lo = prmt(w_t, w_t1, kI4VSelLo);
+  const uint32_t hi = prmt(w_t, w_t1, kI4VSelHi);
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    out[i] = sub_f16x2(((lo >> (4 * i)) & kI4NibbleMask) | kI4Magic, bias);
+    out[4 + i] = sub_f16x2(((hi >> (4 * i)) & kI4NibbleMask) | kI4Magic, bias);
+  }
+}
+
+}  // namespace pth_attn
