+// INT4 counterparts. dec_qk_i4: one K ldmatrix.x4 covers tokens tok0 + 0..15
+// (matrix bit 0) at two 16-B chunks (bit 1) = 64 d = four k16 steps
+// (smem_layout.cuh pi4). kb_lo / kb_hi: the zero-point subtrahends of tokens
+// tok0 + g and tok0 + g + 8 (the A rows of this lane).
+template <int D, int NT, class R>
+__device__ __forceinline__ void dec_qk_i4(float (&s)[NT][4], uint32_t q_smem,
+                                          uint32_t stage_smem, int tok0,
+                                          uint32_t kb_lo, uint32_t kb_hi,
+                                          int lane) {
+  #pragma unroll
+  for (int n = 0; n < NT; ++n) s[n][0] = s[n][1] = s[n][2] = s[n][3] = 0.f;
+  const int mi = lane >> 3, l8 = lane & 7;
+  #pragma unroll
+  for (int ks4 = 0; ks4 < D / (4 * kMmaK); ++ks4) {
+    uint32_t kr[4];
+    ldmatrix_x4(kr, stage_smem + R::k(tok0 + 8 * (mi & 1) + l8,
+                                      (2 * ks4 + (mi >> 1)) * kSmemChunkBytes));
+    // p[m]: matrix m = (token half m & 1, chunk m >> 1); pairs 2h, 2h + 1 are
+    // the (k 2q.., k 2q+8..) registers of k-step 2 (m >> 1) + h.
+    uint32_t p[4][4];
+  #pragma unroll
+    for (int m = 0; m < 4; ++m) {
+      cvt8_u4_f16x2(kr[m], (m & 1) ? kb_hi : kb_lo, p[m]);
+    }
+  #pragma unroll
+    for (int n = 0; n < NT; ++n) {
+      uint32_t qb[2][4];
+  #pragma unroll
+      for (int hq = 0; hq < 2; ++hq) {
+        ldmatrix_x4(qb[hq],
+                    q_smem + q_swz(8 * n + l8, 8 * (8 * ks4 + 4 * hq + mi), D));
+      }
+  #pragma unroll
+      for (int e = 0; e < 4; ++e) {
+        const int cc = e >> 1, h = e & 1;
+        const uint32_t a[4] = {p[2 * cc][2 * h], p[2 * cc + 1][2 * h],
+                               p[2 * cc][2 * h + 1], p[2 * cc + 1][2 * h + 1]};
+        const uint32_t b[2] = {qb[e >> 1][2 * (e & 1)],
+                               qb[e >> 1][2 * (e & 1) + 1]};
+        mma_m16n8k16_f16f32(s[n], a, b);
+      }
+    }
+  }
+}
