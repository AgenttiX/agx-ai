+# agx-ai: images with the vision tower on the CPU (QWEN38_VISION=1, the default), or text only (QWEN38_VISION=0).
+# The size of the images is limited, as the CPU needs ~10 s for 1.2 megapixels. Encoder profiling with a dummy
+# image of the maximum size would take minutes on the CPU and is skipped.
+if [[ "${QWEN38_VISION:-1}" == 1 ]]; then
+  export QWEN38_VISION_DEVICE=${QWEN38_VISION_DEVICE:-cpu}
+  mm_args=(--limit-mm-per-prompt.image "${QWEN38_VISION_MAX_IMAGES:-4}" --limit-mm-per-prompt.video 0
+    --mm-processor-kwargs.max_pixels "${QWEN38_VISION_MAX_PIXELS:-1048576}" --skip-mm-profiling)
+else
+  mm_args=(--language-model-only)
+fi
+
 exec vllm serve "$model" \
   --served-model-name "$SERVED_MODEL_NAME" \
   --host 0.0.0.0 --port "$PORT" \
   --tensor-parallel-size 1 \
+  --gpu-memory-utilization "${GPU_MEMORY_UTILIZATION:-0.8}" \
   --distributed-executor-backend mp \
   --moe-backend humming \
   --dtype bfloat16 \
-  --language-model-only \
+  "${mm_args[@]}" \
   --load-format safetensors \
   --safetensors-load-strategy lazy \
   --max-parallel-loading-workers "$MAX_PARALLEL_LOADING_WORKERS" \
