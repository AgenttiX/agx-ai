{
  "$schema": "https://opencode.ai/config.json",
  // "formatter": true,
  "plugins": [
    "opencode-plugin-litellm@latest"
  ],
  "providers": {
    "litellm": {
      "name": "LiteLLM (proxy)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://litellm.agx.fi/v1"
      }
    }
  },
  "update": "auto"
//  "websearch": {
//    "provider": "tavily"
//  }
}
