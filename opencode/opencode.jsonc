{
  "$schema": "https://opencode.ai/config.json",
  // "formatter": true,
  // These correspond to the permissions in ../claude/settings.json.
  // The last matching rule wins, so the catch-all rules must be first.
  "permissions": [
    // Default
    { "action": "shell", "resource": "*", "effect": "ask" },
    //Allow
    { "action": "shell", "resource": "* --help *", "effect": "allow" },
    { "action": "shell", "resource": "* --version", "effect": "allow" },
    { "action": "shell", "resource": "apt-cache *", "effect": "allow" },
    { "action": "shell", "resource": "arduino-cli board *", "effect": "allow" },
    { "action": "shell", "resource": "arduino-cli help *", "effect": "allow" },
    { "action": "shell", "resource": "arduino-cli sketch *", "effect": "allow" },
    { "action": "shell", "resource": "arduino-cli compile *", "effect": "allow" },
    { "action": "shell", "resource": "arduino-cli upload *", "effect": "allow" },
    { "action": "shell", "resource": "awk *", "effect": "allow" },
    { "action": "shell", "resource": "cargo build *", "effect": "allow" },
    { "action": "shell", "resource": "cargo info *", "effect": "allow" },
    { "action": "shell", "resource": "cargo check *", "effect": "allow" },
    { "action": "shell", "resource": "cargo clippy *", "effect": "allow" },
    { "action": "shell", "resource": "cargo fetch *", "effect": "allow" },
    { "action": "shell", "resource": "cargo run *", "effect": "allow" },
    { "action": "shell", "resource": "cargo search *", "effect": "allow" },
    { "action": "shell", "resource": "cargo test *", "effect": "allow" },
    { "action": "shell", "resource": "chromium * --screenshot=* *", "effect": "allow" },
    { "action": "shell", "resource": "clinfo *", "effect": "allow" },
    { "action": "shell", "resource": "conda * --dry-run *", "effect": "allow" },
    { "action": "shell", "resource": "conda list", "effect": "allow" },
    { "action": "shell", "resource": "convert *", "effect": "allow" },
    { "action": "shell", "resource": "curl *", "effect": "allow" },
    { "action": "shell", "resource": "docker compose pull", "effect": "allow" },
    { "action": "shell", "resource": "docker version *", "effect": "allow" },
    { "action": "shell", "resource": "docker pull *", "effect": "allow" },
    { "action": "shell", "resource": "dpkg -l *", "effect": "allow" },
    { "action": "shell", "resource": "lsb_release *", "effect": "allow" },
    { "action": "shell", "resource": "lspci *", "effect": "allow" },
    { "action": "shell", "resource": "montage *", "effect": "allow" },
    { "action": "shell", "resource": "mypy *", "effect": "allow" },
    { "action": "shell", "resource": "nvidia-smi *", "effect": "allow" },
    { "action": "shell", "resource": "pdfinfo *", "effect": "allow" },
    { "action": "shell", "resource": "pip-check *", "effect": "allow" },
    { "action": "shell", "resource": "pip download *", "effect": "allow" },
    { "action": "shell", "resource": "pip freeze *", "effect": "allow" },
    { "action": "shell", "resource": "pip list *", "effect": "allow" },
    { "action": "shell", "resource": "pip search *", "effect": "allow" },
    { "action": "shell", "resource": "pip show *", "effect": "allow" },
    { "action": "shell", "resource": "pip check *", "effect": "allow" },
    { "action": "shell", "resource": "pylint *", "effect": "allow" },
    { "action": "shell", "resource": "pyrefly *", "effect": "allow" },
    { "action": "shell", "resource": "pytest *", "effect": "allow" },
    { "action": "shell", "resource": "ruff *", "effect": "allow" },
    { "action": "shell", "resource": "uname *", "effect": "allow" },
    { "action": "shell", "resource": "vulkaninfo *", "effect": "allow" },
    { "action": "shell", "resource": "where *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    // PowerShell
    { "action": "shell", "resource": "Get-Module *", "effect": "allow" },
    { "action": "shell", "resource": "Invoke-ScriptAnalyzer *", "effect": "allow" },
    { "action": "shell", "resource": "Test-Path *", "effect": "allow" },
    // External directories
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/dev/*", "effect": "allow" },
    { "action": "external_directory", "resource": "C:/cygwin64/*", "effect": "allow" },
    { "action": "external_directory", "resource": "C:/phoronix-test-suite/*", "effect": "allow" },
    { "action": "external_directory", "resource": "C:/PHP/*", "effect": "allow" },
    { "action": "external_directory", "resource": "C:/ProgramData/chocolatey/*", "effect": "allow" },
    { "action": "external_directory", "resource": "C:/Qt/*", "effect": "allow" },
    { "action": "external_directory", "resource": "C:/tools/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cargo/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.zgen/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.zshenv", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.zshrc", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Git/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/git/*", "effect": "allow" },
    // Denied edits
    { "action": "edit", "resource": "V:/*", "effect": "deny" },
    { "action": "edit", "resource": "W:/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/id_*", "effect": "deny" },
    // Denied reads
    { "action": "read", "resource": "/mnt/agx-file/archive/*", "effect": "deny" },
    { "action": "read", "resource": "/mnt/agx-file/backup/*", "effect": "deny" },
    { "action": "read", "resource": "/mnt/agx-file/files/*", "effect": "deny" },
    { "action": "read", "resource": "/mnt/dbfiles/*", "effect": "deny" },
    { "action": "read", "resource": "/mnt/holvi/*", "effect": "deny" },
    { "action": "read", "resource": "/mnt/rk-files/*", "effect": "deny" },
    { "action": "read", "resource": "/mnt/vxl-files/*", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/id_*", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/id_*.pub", "effect": "allow" },
    { "action": "read", "resource": "~/Vaults/*", "effect": "deny" },
    // Tools
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ],
  "plugins": [
    "opencode-plugin-litellm@latest"
  ],
  "providers": {
    "litellm": {
      "name": "LiteLLM (proxy)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://litellm.agx.fi/v1"
      }
    }
  },
  "update": "auto"
//  "websearch": {
//    "provider": "tavily"
//  }
}
