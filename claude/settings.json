{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(* --help *)",
      "Bash(* --version)",
      "Bash(apt-cache *)",
      "Bash(arduino-cli board *)",
      "Bash(arduino-cli help *)",
      "Bash(arduino-cli sketch *)",
      "Bash(arduino-cli compile *)",
      "Bash(arduino-cli upload *)",
      "Bash(awk *)",
      "Bash(cargo build *)",
      "Bash(cargo info *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fetch *)",
      "Bash(cargo run *)",
      "Bash(cargo search *)",
      "Bash(cargo test *)",
      "Bash(chromium * --screenshot=* *)",
      "Bash(clinfo *)",
      "Bash(conda * --dry-run *)",
      "Bash(conda list)",
      "Bash(convert *)",
      "Bash(curl *)",
      "Bash(docker compose pull)",
      "Bash(docker version *)",
      "Bash(docker pull *)",
      "Bash(dpkg -l *)",
      "Bash(lsb_release *)",
      "Bash(lspci *)",
      "Bash(montage *)",
      "Bash(mypy *)",
      "Bash(nvidia-smi *)",
      "Bash(pdfinfo *)",
      "Bash(pip-check *)",
      "Bash(pip download *)",
      "Bash(pip freeze *)",
      "Bash(pip list *)",
      "Bash(pip search *)",
      "Bash(pip show *)",
      "Bash(pip check *)",
      "Bash(pylint *)",
      "Bash(pytest *)",
      "Bash(uname *)",
      "Bash(vulkaninfo *)",
      "Bash(where *)",
      "Bash(which *)",
      "Edit(//tmp/**)",
      "PowerShell(* --help *)",
      "PowerShell(* --version)",
      "PowerShell(Get-Module *)",
      "PowerShell(Invoke-ScriptAnalyzer *)",
      "PowerShell(Test-Path *)",
      "Read(//c/cygwin64/**)",
      "Read(//c/phoronix-test-suite/**)",
      "Read(//c/PHP/**)",
      "Read(//c/ProgramData/chocolatey/**)",
      "Read(//c/Qt/**)",
      "Read(//c/tools/**)",
      "Read(//dev/**)",
      "Read(~/.cargo/**)",
      "Read(~/.claude/jobs/*/tmp/**)",
      "Read(~/.zgen/**)",
      "Read(~/.zshenv)",
      "Read(~/.zshrc)",
      "Read(~/Git/**)",
      "Read(~/git/**)",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Edit(//v/**)",
      "Edit(//w/**)",
      "Read(//mnt/**)",
      "Read(//mnt/holvi)",
      "Read(~/Vaults)"
    ]
  },
  "model": "opus",
  "enableWorkflows": true,
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true
}
