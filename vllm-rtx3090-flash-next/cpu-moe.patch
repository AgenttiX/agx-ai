+// y[t][n] = sum_k xq[t][k] (q[k][n] - 8) s[k / 128][n] xs[t][k / QG] for the columns [n0, n1) (multiple of 16).
+// Within a group (16 packed rows, contiguous in memory), each block of 16 columns keeps its int32 sums in registers.
+template <int T>
+static void gemv_q8(const int32_t* __restrict qw, const uint16_t* __restrict sc, int K, int N, int n0, int n1,
+                    const int8_t* __restrict xq, const float* __restrict xs, const int32_t* __restrict xz,
+                    float* __restrict y, int ldy) {
+  alignas(32) float tot[T][MAXC];
+  const int W = n1 - n0;
+  for (int t = 0; t < T; ++t) std::memset(tot[t], 0, sizeof(float) * W);
+  const __m256i mask = _mm256_set1_epi32(0x0F0F0F0F);
+  const __m256i ones = _mm256_set1_epi16(1);
+  const int groups = K / GS;
+  constexpr int SUB = GS / QG, SR = QG / 8;  // activation groups per weight group, packed rows per activation group
+  const int qgroups = K / QG;
+  for (int g = 0; g < groups; ++g) {
+    const int r0 = g * (GS / 8);
+    if (g + 1 < groups) {  // the next group's rows: 16 * N * 4 bytes, contiguous
+      const char* nxt = reinterpret_cast<const char*>(qw + static_cast<size_t>(r0 + GS / 8) * N + n0);
+      for (int r = 0; r < GS / 8; ++r)
+        for (int b = 0; b < W * 4; b += 64) _mm_prefetch(nxt + static_cast<size_t>(r) * N * 4 + b, _MM_HINT_T1);
+    }
+    // Per row and token: the int8 activations of the row's 8 k as two broadcast 4-byte patterns (even, odd k).
+    __m256i xe[GS / 8][T], xo[GS / 8][T];
+    for (int r = 0; r < GS / 8; ++r)
+      for (int t = 0; t < T; ++t) {
+        const int8_t* xr = xq + static_cast<size_t>(t) * K + (r0 + r) * 8;
+        const int32_t e = (xr[0] & 0xFF) | (xr[2] & 0xFF) << 8 | (xr[4] & 0xFF) << 16 | (xr[6] & 0xFF) << 24;
+        const int32_t o = (xr[1] & 0xFF) | (xr[3] & 0xFF) << 8 | (xr[5] & 0xFF) << 16 | (xr[7] & 0xFF) << 24;
+        xe[r][t] = _mm256_set1_epi32(e);
+        xo[r][t] = _mm256_set1_epi32(o);
+      }
+    const uint16_t* srow = sc + static_cast<size_t>(g) * N + n0;
+    for (int c = 0; c < W; c += 16) {
+      __m256 fa[T][2];
+      for (int t = 0; t < T; ++t) fa[t][0] = fa[t][1] = _mm256_setzero_ps();
+      for (int sg = 0; sg < SUB; ++sg) {
+        __m256i acc[T][2];
+        for (int t = 0; t < T; ++t) acc[t][0] = acc[t][1] = _mm256_setzero_si256();
+        for (int rr = 0; rr < SR; ++rr) {
+          const int r = sg * SR + rr;
+          const int32_t* row = qw + static_cast<size_t>(r0 + r) * N + n0 + c;
+          for (int u = 0; u < 2; ++u) {
+            const __m256i q = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(row + 8 * u));
+            const __m256i lo = _mm256_and_si256(q, mask), hi = _mm256_and_si256(_mm256_srli_epi32(q, 4), mask);
+            for (int t = 0; t < T; ++t) {
+              const __m256i pp = _mm256_add_epi16(_mm256_maddubs_epi16(lo, xe[r][t]), _mm256_maddubs_epi16(hi, xo[r][t]));
+              acc[t][u] = _mm256_add_epi32(acc[t][u], _mm256_madd_epi16(pp, ones));
+            }
+          }
+        }
+        const int qg = g * SUB + sg;
+        for (int t = 0; t < T; ++t)
+          for (int u = 0; u < 2; ++u) {
+            const __m256i d = _mm256_sub_epi32(acc[t][u], _mm256_set1_epi32(xz[t * qgroups + qg]));
+            fa[t][u] = _mm256_fmadd_ps(_mm256_set1_ps(xs[t * qgroups + qg]), _mm256_cvtepi32_ps(d), fa[t][u]);
+          }
+      }
+      for (int u = 0; u < 2; ++u) {
+        const __m256 sv = load_h8(srow + c + 8 * u);
+        for (int t = 0; t < T; ++t)
+          _mm256_store_ps(&tot[t][c + 8 * u], _mm256_fmadd_ps(sv, fa[t][u], _mm256_load_ps(&tot[t][c + 8 * u])));
+      }
+    }
+  }
+  for (int t = 0; t < T; ++t) std::memcpy(y + static_cast<size_t>(t) * ldy, tot[t], sizeof(float) * W);
+}
