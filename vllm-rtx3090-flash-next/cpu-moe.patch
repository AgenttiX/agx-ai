+static void gemv_q16_cols(const int32_t* qw, const uint16_t* sc, int K, int N, int n0, int n1, int Tn,
+                          const int16_t* xq, const float* xs, const int32_t* xz, float* y, int ldy) {
+  for (int a = n0; a < n1; a += MAXC) {
+    const int b = std::min(n1, a + MAXC);
+    switch (Tn) {
+      case 1: gemv_q16<1>(qw, sc, K, N, a, b, xq, xs, xz, y + (a - n0), ldy); break;
+      case 2: gemv_q16<2>(qw, sc, K, N, a, b, xq, xs, xz, y + (a - n0), ldy); break;
+      case 3: gemv_q16<3>(qw, sc, K, N, a, b, xq, xs, xz, y + (a - n0), ldy); break;
+      default: gemv_q16<4>(qw, sc, K, N, a, b, xq, xs, xz, y + (a - n0), ldy); break;
+    }
+  }
+}
