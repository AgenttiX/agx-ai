+    switch (Tn) {
+      case 1: gemv_q8<1>(qw, sc, K, N, a, b, xq, xs, xz, y + (a - n0), ldy); break;
+      case 2: gemv_q8<2>(qw, sc, K, N, a, b, xq, xs, xz, y + (a - n0), ldy); break;
+      case 3: gemv_q8<3>(qw, sc, K, N, a, b, xq, xs, xz, y + (a - n0), ldy); break;
+      default: gemv_q8<4>(qw, sc, K, N, a, b, xq, xs, xz, y + (a - n0), ldy); break;
+    }
+  }
+}
