+// agx-ai: integer activations for the CPU experts, selected at startup (the default stays FP32).
+// INT8 (QWEN38_CPU_EXPERTS_INT8=1): each token's activations are quantized to int8 with one scale per group of QG
+// (32, like llama.cpp's Q8_0 activations; the weights' groups are 128), and the products with the int4 weights
+// (0..15) are summed exactly in int32 with vpmaddubsw/vpmaddwd: 64 weights per ~8 instructions instead of 8 per 4
+// with FP32 activations. A thread computes an expert ~2.3 times as fast (in cache), so 8 threads reach the memory
+// bandwidth. Relative error of an expert's output ~1 % (FP32: 1e-7, the GPU's BF16 activations: ~0.3 %). The zero
+// point 8 is subtracted with the group sums of the quantized activations:
+//   y[n] = sum over weight groups g of s[g][n] * sum over activation groups a in g of xs[a] (sum_k xq[k] q[k][n] - 8 sum_k xq[k]).
+#ifndef QG
+#define QG 32
+#endif
+bool g_int8 = [] { const char* v = std::getenv("QWEN38_CPU_EXPERTS_INT8"); return v && v[0] == '1'; }();
+bool g_int16 = [] { const char* v = std::getenv("QWEN38_CPU_EXPERTS_INT16"); return v && v[0] == '1'; }();
+
+// INT16 (QWEN38_CPU_EXPERTS_INT16=1): one scale per group of 128, practically exact (relative error ~6e-5), and the
+// products with the int4 weights summed in int32 with vpmaddwd: 64 weights per ~16 instructions, ~1.3 times as fast
+// as FP32 per thread. x fp32 [T][K] -> xq int16 [T][K], xs fp32 [T][K/128], xz int32 [T][K/128] (8 * sum of xq).
+static void quantize_q16(const float* x, int T, int K, int16_t* xq, float* xs, int32_t* xz) {
+  const int groups = K / GS;
+  for (int t = 0; t < T; ++t)
+    for (int g = 0; g < groups; ++g) {
+      const float* xp = x + static_cast<size_t>(t) * K + g * GS;
+      float amax = 0.f;
+      for (int k = 0; k < GS; ++k) amax = std::max(amax, std::fabs(xp[k]));
+      const float inv = amax > 0.f ? 32767.f / amax : 0.f;
+      int16_t* q = xq + static_cast<size_t>(t) * K + g * GS;
+      int32_t sum = 0;
+      for (int k = 0; k < GS; ++k) {
+        const int v = static_cast<int>(std::nearbyint(xp[k] * inv));
+        q[k] = static_cast<int16_t>(v);
+        sum += v;
+      }
+      xs[t * groups + g] = amax / 32767.f;
+      xz[t * groups + g] = 8 * sum;
+    }
+}
