+// x fp32 [T][K] -> xq int8 [T][K], xs fp32 [T][K/QG] (scale), xz int32 [T][K/QG] (8 * sum of xq in the group)
+static void quantize_q8(const float* x, int T, int K, int8_t* xq, float* xs, int32_t* xz) {
+  const int groups = K / QG;
+  const __m256 sign = _mm256_set1_ps(-0.0f);
+  for (int t = 0; t < T; ++t)
+    for (int g = 0; g < groups; ++g) {
+      const float* xp = x + static_cast<size_t>(t) * K + g * QG;
+      __m256 m = _mm256_setzero_ps();
+      for (int k = 0; k < QG; k += 8) m = _mm256_max_ps(m, _mm256_andnot_ps(sign, _mm256_loadu_ps(xp + k)));
+      __m128 m4 = _mm_max_ps(_mm256_castps256_ps128(m), _mm256_extractf128_ps(m, 1));
+      m4 = _mm_max_ps(m4, _mm_movehl_ps(m4, m4));
+      m4 = _mm_max_ss(m4, _mm_shuffle_ps(m4, m4, 1));
+      const float amax = _mm_cvtss_f32(m4);
+      const float scale = amax / 127.f, inv = amax > 0.f ? 127.f / amax : 0.f;
+      int8_t* q = xq + static_cast<size_t>(t) * K + g * QG;
+      int32_t sum = 0;
+      for (int k = 0; k < QG; ++k) {
+        const int v = static_cast<int>(std::nearbyint(xp[k] * inv));
+        q[k] = static_cast<int8_t>(v);
+        sum += v;
+      }
+      xs[t * groups + g] = scale;
+      xz[t * groups + g] = 8 * sum;
+    }
+}
