+// The int16 GEMV: in each int32 of the weights, the nibble pairs (j, j + 4) are 16-bit lanes after a shift by 4j
+// and a mask, multiplied with the activation pairs (k = 8r + j, 8r + j + 4) by vpmaddwd.
+template <int T>
+static void gemv_q16(const int32_t* __restrict qw, const uint16_t* __restrict sc, int K, int N, int n0, int n1,
+                     const int16_t* __restrict xq, const float* __restrict xs, const int32_t* __restrict xz,
+                     float* __restrict y, int ldy) {
+  alignas(32) float tot[T][MAXC];
+  const int W = n1 - n0;
+  for (int t = 0; t < T; ++t) std::memset(tot[t], 0, sizeof(float) * W);
+  const __m256i mask = _mm256_set1_epi32(0x000F000F);
+  const int groups = K / GS;
+  for (int g = 0; g < groups; ++g) {
+    const int r0 = g * (GS / 8);
+    if (g + 1 < groups) {
+      const char* nxt = reinterpret_cast<const char*>(qw + static_cast<size_t>(r0 + GS / 8) * N + n0);
+      for (int r = 0; r < GS / 8; ++r)
+        for (int b = 0; b < W * 4; b += 64) _mm_prefetch(nxt + static_cast<size_t>(r) * N * 4 + b, _MM_HINT_T1);
+    }
+    const uint16_t* srow = sc + static_cast<size_t>(g) * N + n0;
+    for (int c = 0; c < W; c += 16) {
+      __m256i acc[T][2];
+      for (int t = 0; t < T; ++t) acc[t][0] = acc[t][1] = _mm256_setzero_si256();
+      for (int r = 0; r < GS / 8; ++r) {
+        const int32_t* row = qw + static_cast<size_t>(r0 + r) * N + n0 + c;
+        __m256i xp[T][4];
+        for (int t = 0; t < T; ++t) {
+          const uint16_t* xr = reinterpret_cast<const uint16_t*>(xq + static_cast<size_t>(t) * K + (r0 + r) * 8);
+          for (int j = 0; j < 4; ++j) xp[t][j] = _mm256_set1_epi32(static_cast<int32_t>(xr[j] | (xr[j + 4] << 16)));
+        }
+        for (int u = 0; u < 2; ++u) {
+          const __m256i q = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(row + 8 * u));
+          const __m256i w0 = _mm256_and_si256(q, mask), w1 = _mm256_and_si256(_mm256_srli_epi32(q, 4), mask);
+          const __m256i w2 = _mm256_and_si256(_mm256_srli_epi32(q, 8), mask);
+          const __m256i w3 = _mm256_and_si256(_mm256_srli_epi32(q, 12), mask);
+          for (int t = 0; t < T; ++t) {
+            const __m256i s01 = _mm256_add_epi32(_mm256_madd_epi16(w0, xp[t][0]), _mm256_madd_epi16(w1, xp[t][1]));
+            const __m256i s23 = _mm256_add_epi32(_mm256_madd_epi16(w2, xp[t][2]), _mm256_madd_epi16(w3, xp[t][3]));
+            acc[t][u] = _mm256_add_epi32(acc[t][u], _mm256_add_epi32(s01, s23));
+          }
+        }
+      }
+      for (int u = 0; u < 2; ++u) {
+        const __m256 sv = load_h8(srow + c + 8 * u);
+        for (int t = 0; t < T; ++t) {
+          const __m256i d = _mm256_sub_epi32(acc[t][u], _mm256_set1_epi32(xz[t * groups + g]));
+          const __m256 f = _mm256_mul_ps(sv, _mm256_set1_ps(xs[t * groups + g]));
+          _mm256_store_ps(&tot[t][c + 8 * u],
+                          _mm256_fmadd_ps(f, _mm256_cvtepi32_ps(d), _mm256_load_ps(&tot[t][c + 8 * u])));
+        }
+      }
+    }
+  }
+  for (int t = 0; t < T; ++t) std::memcpy(y + static_cast<size_t>(t) * ldy, tot[t], sizeof(float) * W);
+}
