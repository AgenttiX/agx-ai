+        self.k_min = max(1, min(k_max, int(os.environ.get("QWEN38_MTP_MIN", "1"))))
+        self.cost = float(os.environ.get("QWEN38_MTP_COST", "0.1"))
+        self.alpha = float(os.environ.get("QWEN38_MTP_ALPHA", "0.15"))
