+        self._t_prev = now
+        if drafts <= 0:
+            return
+        if dt is not None and 0.0 < dt < 0.3:  # (not after a pause or a prefill)
+            t = self.time[drafts]
+            self.time[drafts] = dt if t is None else t + 0.1 * (dt - t)
+        a = self.alpha
+        for i in range(min(accepted, drafts)):
+            self.acc[i] += a * (1.0 - self.acc[i])
+        if accepted < drafts:
+            self.acc[accepted] -= a * self.acc[accepted]
+        last = self.acc[min(accepted, drafts - 1)]
