+# agx-ai: images and videos with the vision tower on the CPU (QWEN38_VISION=1, the default), or text only
+# (QWEN38_VISION=0). The CPU needs ~1.4 ms per 16x16 patch, so the sizes are limited: each image to
+# QWEN38_VISION_MAX_PIXELS, and each video to QWEN38_VISION_VIDEO_MAX_FRAMES frames (sampled at 2 per second, only
+# these are decoded) with QWEN38_VISION_VIDEO_MAX_PIXELS pixels over all frames. Encoder profiling with a dummy
+# input of the maximum size would take minutes on the CPU and is skipped.
+if [[ "${QWEN38_VISION:-1}" == 1 ]]; then
+  export QWEN38_VISION_DEVICE=${QWEN38_VISION_DEVICE:-cpu}
+  export VLLM_VIDEO_LOADER_BACKEND=${VLLM_VIDEO_LOADER_BACKEND:-qwen3_vl}
+  mm_args=(--limit-mm-per-prompt.image "${QWEN38_VISION_MAX_IMAGES:-4}"
+    --limit-mm-per-prompt.video "${QWEN38_VISION_MAX_VIDEOS:-1}"
+    --mm-processor-kwargs.max_pixels "${QWEN38_VISION_MAX_PIXELS:-1048576}"
+    --mm-processor-kwargs.video_max_pixels "${QWEN38_VISION_VIDEO_MAX_PIXELS:-12582912}"
+    --media-io-kwargs.video.max_frames "${QWEN38_VISION_VIDEO_MAX_FRAMES:-64}"
+    --skip-mm-profiling)
+else
+  mm_args=(--language-model-only)
+fi
+
 exec vllm serve "$model" \
   --served-model-name "$SERVED_MODEL_NAME" \
   --host 0.0.0.0 --port "$PORT" \
   --tensor-parallel-size 1 \
+  --gpu-memory-utilization "${GPU_MEMORY_UTILIZATION:-0.8}" \
   --distributed-executor-backend mp \
   --moe-backend humming \
   --dtype bfloat16 \
-  --language-model-only \
+  "${mm_args[@]}" \
   --load-format safetensors \
   --safetensors-load-strategy lazy \
   --max-parallel-loading-workers "$MAX_PARALLEL_LOADING_WORKERS" \
