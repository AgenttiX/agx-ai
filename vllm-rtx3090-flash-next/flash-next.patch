+import os as _os
+# agx-ai: QWEN38_INT8_SKINNY=1 stores the weights of the skinny-GEMM modules whose names contain one of
+# QWEN38_INT8_SKINNY_MODULES (comma-separated, default "lm_head") in int8 with one scale per row and 128 inputs.
+# Only the heads gain: in CUDA graphs on the RTX 3090, the lm_head takes 791 instead of 1483 us per decode step and
+# each of MTP's 3 drafts 211 instead of 399 us (its reduced vocabulary is a view of the same weight), while the small
+# projections of the layers are bound by latency, not by their weight reads, and were not faster (some slower).
+_INT8_SKINNY = _os.environ.get("QWEN38_INT8_SKINNY", "0") == "1"
+_INT8_MODULES = [p for p in _os.environ.get("QWEN38_INT8_SKINNY_MODULES", "lm_head").split(",") if p]
+
+
+def _quantize_layer_i8(layer: nn.Module) -> None:
+    """agx-ai: replace the BF16 weight of a skinny-GEMM module by int8 with one scale per row and 128 inputs (the
+    attribute `qscale` of the new parameter), which apply() and the reduced draft head (draft_vocab.py) use."""
+    weight = getattr(layer, "weight", None)
+    if weight is None or weight.dtype != torch.bfloat16 or not weight.is_cuda or weight.dim() != 2:
+        return
+    name = getattr(layer, "_qwen38_name", "") or getattr(layer, "prefix", "")
+    if not any(p in name for p in _INT8_MODULES):
+        return
+    from .triton_skinny import quantize_rows_i8
+    q, scale = quantize_rows_i8(weight.data)
+    param = nn.Parameter(q, requires_grad=False)
+    param.qscale = scale
+    for attr in ("weight_loader", "output_dim", "input_dim"):
+        if hasattr(weight, attr):
+            setattr(param, attr, getattr(weight, attr))
+    del layer.weight
+    layer.weight = param
+    del weight
+    torch.cuda.empty_cache()
+
