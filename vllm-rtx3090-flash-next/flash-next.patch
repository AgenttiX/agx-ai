+
+
+# agx-ai: int8 weights with one FP32 scale per output row and group of GROUP_K (128) inputs (QWEN38_INT8_SKINNY=1,
+# low_latency_gemm.py). The lm_head is bound by its weight reads, and int8 halves them; int8 -> BF16 is exact, and
+# each group's scale is applied to the group's FP32 dot product (per-row scales alone: KL divergence 1.5 times the
+# noise floor in the retrieval test).
+GROUP_K = 128
+@triton.jit
+def _skinny_dot_i8_kernel(x_ptr, w_ptr, s_ptr, out_ptr, part_ptr, M, N, K,
+                          stride_xm, stride_wn, stride_om, stride_sn,
+                          K_PER_SPLIT: tl.constexpr, BLOCK_N: tl.constexpr,
+                          BLOCK_K: tl.constexpr, SPLIT_K: tl.constexpr, STAGES: tl.constexpr):
+    pid_n = tl.program_id(0)
+    pid_k = tl.program_id(1)
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    offs_m = tl.arange(0, 16)
+    n_mask = offs_n < N
+    m_mask = offs_m < M
+    acc = tl.zeros((16, BLOCK_N), dtype=tl.float32)
+    k_start = pid_k * K_PER_SPLIT
+    for k0 in tl.range(0, K_PER_SPLIT, BLOCK_K, num_stages=STAGES):
+        offs_k = k_start + k0 + tl.arange(0, BLOCK_K)
+        k_mask = offs_k < K
+        w = tl.load(w_ptr + offs_n[:, None] * stride_wn + offs_k[None, :],
+                    mask=n_mask[:, None] & k_mask[None, :], other=0,
+                    eviction_policy='evict_first').to(tl.bfloat16)
+        x = tl.load(x_ptr + offs_m[:, None] * stride_xm + offs_k[None, :],
+                    mask=m_mask[:, None] & k_mask[None, :], other=0.0)
+        # One FP32 scale per row and group of BLOCK_K inputs, applied to the group's FP32 dot product.
+        scale = tl.load(s_ptr + offs_n * stride_sn + (k_start + k0) // BLOCK_K, mask=n_mask, other=0.0)
+        acc += tl.dot(x, tl.trans(w)) * scale[None, :]
+    if SPLIT_K == 1:
+        tl.store(out_ptr + offs_m[:, None] * stride_om + offs_n[None, :],
+                 acc.to(out_ptr.dtype.element_ty), mask=m_mask[:, None] & n_mask[None, :])
+    else:
+        base = part_ptr + pid_k * (16 * N)
+        tl.store(base + offs_m[:, None] * N + offs_n[None, :], acc,
+                 mask=m_mask[:, None] & n_mask[None, :])
+
+
+def skinny_mm_i8(x, w, scale):
+    """x [M <= 8, K] BF16, w [N, K] int8, scale [N, K / GROUP_K] FP32 -> [M, N] BF16."""
+    m, k = x.shape
+    n = w.shape[0]
+    bn, _, split, stages = config_for(n, k)
+    bk = GROUP_K
+    assert k % GROUP_K == 0 and scale.shape == (n, k // GROUP_K)
+    out = torch.empty((m, n), dtype=x.dtype, device=x.device)
+    k_per_split = triton.cdiv(triton.cdiv(k, split), bk) * bk
+    part = out
+    if split > 1:
+        key = (x.device, split * 16 * n)
+        part = _workspace.get(key)
+        if part is None:
+            part = torch.empty(split * 16 * n, dtype=torch.float32, device=x.device)
+            _workspace[key] = part
+    _skinny_dot_i8_kernel[(triton.cdiv(n, bn), split)](
+        x, w, scale, out, part, m, n, k, x.stride(0), w.stride(0), out.stride(0), scale.stride(0),
+        K_PER_SPLIT=k_per_split, BLOCK_N=bn, BLOCK_K=bk, SPLIT_K=split,
+        STAGES=stages, num_warps=4)
+    if split > 1:
+        _reduce_kernel[(triton.cdiv(n, 128),)](part, out, m, n, out.stride(0), BLOCK_M=16,
+                                                BLOCK_N=128, SPLIT_K=split, num_warps=4)
+    return out
+
+
+def linear_i8(x, w, scale, chunk_rows=32768):
+    """F.linear with an int8 weight and per-row scales: the skinny kernel for up to 8 rows, else the weight
+    dequantized in chunks of rows (the lm_head would be 1.27 GB in BF16)."""
+    lead = x.shape[:-1]
+    x2 = x.reshape(-1, x.shape[-1])
+    if x2.shape[0] <= MAX_M and x2.dtype == torch.bfloat16 and x2.is_contiguous():
+        return skinny_mm_i8(x2, w, scale).reshape(*lead, w.shape[0])
+    parts = []
+    for r0 in range(0, w.shape[0], chunk_rows):
+        wc = w[r0:r0 + chunk_rows]
+        sc = scale[r0:r0 + chunk_rows]
+        wd = (wc.view(wc.shape[0], -1, GROUP_K).float() * sc[:, :, None]).reshape(wc.shape).to(x2.dtype)
+        parts.append(torch.nn.functional.linear(x2, wd))
+    out = parts[0] if len(parts) == 1 else torch.cat(parts, dim=-1)
+    return out.reshape(*lead, w.shape[0])
+
+
+def quantize_rows_i8(w, chunk_rows=16384):
+    """Symmetric int8 per output row and group of GROUP_K inputs: (int8 [N, K], FP32 scale [N, K / GROUP_K]), in
+    chunks of rows to bound the temporaries."""
+    n, k = w.shape
+    assert k % GROUP_K == 0
+    q = torch.empty(w.shape, dtype=torch.int8, device=w.device)
+    s = torch.empty((n, k // GROUP_K), dtype=torch.float32, device=w.device)
+    for r0 in range(0, n, chunk_rows):
+        wf = w[r0:r0 + chunk_rows].float().view(-1, k // GROUP_K, GROUP_K)
+        sc = wf.abs().amax(dim=2).clamp(min=1e-30) / 127.0
+        q[r0:r0 + chunk_rows] = torch.round(wf / sc[:, :, None]).clamp(-127, 127).to(torch.int8).view(-1, k)
+        s[r0:r0 + chunk_rows] = sc
+    return q, s
