diff -ru a/usr/local/lib/python3.12/dist-packages/vllm/models/qwen3_8_flash_next/nvidia/triton_skinny.py b/usr/local/lib/python3.12/dist-packages/vllm/models/qwen3_8_flash_next/nvidia/triton_skinny.py
--- a/usr/local/lib/python3.12/dist-packages/vllm/models/qwen3_8_flash_next/nvidia/triton_skinny.py
+++ b/usr/local/lib/python3.12/dist-packages/vllm/models/qwen3_8_flash_next/nvidia/triton_skinny.py
@@ -106,3 +106,99 @@
         _reduce_kernel[(triton.cdiv(n, 128),)](part, out, m, n, out.stride(0), BLOCK_M=16,
                                                 BLOCK_N=128, SPLIT_K=split, num_warps=4)
