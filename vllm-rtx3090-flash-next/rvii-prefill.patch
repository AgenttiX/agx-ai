+// agx-ai: Radeon VII prefill (rvii_prefill.py, rvii_protocol.h): the request's T and layer, then its seq, after the
+// DMAs of its data on the same stream; on the compute stream, a wait for the worker's response (with a timeout, after
+// which *ok = 0 and the host's timeout counter is incremented) and the add of its y (BF16, in host memory).
+__global__ void pf_publish_kernel(char* req, long long seq, int T, int layer) {
+  *reinterpret_cast<volatile int*>(req + 8) = T;
+  *reinterpret_cast<volatile int*>(req + 12) = layer;
+  __threadfence_system();
+  asm volatile("st.release.sys.global.b64 [%0], %1;" ::"l"(req), "l"(seq) : "memory");
+}
+
+__global__ void pf_wait_kernel(const char* resp, long long seq, long long timeout_ns, int* ok, int* timeouts) {
+  unsigned long long t0, t;
+  asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t0));
+  long long v;
+  for (;;) {
+    asm volatile("ld.acquire.sys.global.b64 %0, [%1];" : "=l"(v) : "l"(resp) : "memory");
+    if (v == seq) { *ok = 1; return; }
+    __nanosleep(2000);
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+    if (static_cast<long long>(t - t0) > timeout_ns) {
+      *ok = 0;
+      *reinterpret_cast<volatile int*>(timeouts) += 1;
+      __threadfence_system();
+      return;
+    }
+  }
+}
+
+__global__ void pf_add_kernel(float* __restrict__ acc, long long n4, const uint2* y, const int* ok) {
+  if (!*ok) return;
+  for (long long i = blockIdx.x * static_cast<long long>(blockDim.x) + threadIdx.x; i < n4;
+       i += static_cast<long long>(gridDim.x) * blockDim.x) {
+    const uint2 v = __ldcv(y + i);  // 4 BF16
+    float4 a = reinterpret_cast<float4*>(acc)[i];
+    a.x += __uint_as_float(v.x << 16); a.y += __uint_as_float(v.x & 0xFFFF0000u);
+    a.z += __uint_as_float(v.y << 16); a.w += __uint_as_float(v.y & 0xFFFF0000u);
+    reinterpret_cast<float4*>(acc)[i] = a;
+  }
+}
 }  // namespace
 
+void rvii_pf_publish(int64_t req_addr, int64_t seq, int64_t T, int64_t layer) {
+  pf_publish_kernel<<<1, 1, 0, c10::cuda::getCurrentCUDAStream()>>>(reinterpret_cast<char*>(req_addr), seq,
+                                                                     static_cast<int>(T), static_cast<int>(layer));
+}
+
+void rvii_pf_wait_add(torch::Tensor acc, int64_t resp_addr, int64_t y_addr, int64_t seq, int64_t timeout_ns,
+                      torch::Tensor ok, int64_t timeouts_addr) {
+  TORCH_CHECK(acc.dtype() == torch::kFloat32 && acc.is_contiguous() && acc.numel() % 4 == 0);
+  TORCH_CHECK(ok.dtype() == torch::kInt32 && ok.is_cuda());
+  auto stream = c10::cuda::getCurrentCUDAStream();
+  int* okp = ok.data_ptr<int32_t>();
+  pf_wait_kernel<<<1, 1, 0, stream>>>(reinterpret_cast<const char*>(resp_addr), seq, timeout_ns, okp,
+                                      reinterpret_cast<int*>(timeouts_addr));
+  const long long n4 = acc.numel() / 4;
+  pf_add_kernel<<<static_cast<int>(std::min<long long>(1312, (n4 + 255) / 256)), 256, 0, stream>>>(
+      acc.data_ptr<float>(), n4, reinterpret_cast<const uint2*>(y_addr), okp);
+}
